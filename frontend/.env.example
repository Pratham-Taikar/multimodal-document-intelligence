# Optional: absolute backend origin seen by the browser.
# Leave empty to use same-origin relative URLs (/api/...), proxied to the
# backend by the Vite dev server — this is the recommended default.
VITE_API_BASE_URL=

# Target the Vite dev server proxies /api requests to (server-side only).
VITE_API_PROXY_TARGET=http://localhost:8000
