<%- include('partials/header', { title: "Authentication - AskMyNotes" }) %>

<body class="bg-[#080c14] text-slate-100 min-h-screen flex items-center justify-center px-4 relative overflow-hidden selection:bg-indigo-500 selection:text-white">

    <!-- Subtle Radial Glow Background -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-indigo-600/10 rounded-full blur-[140px] pointer-events-none"></div>

    <div class="w-full max-w-md bg-slate-900/90 border border-slate-800 rounded-2xl shadow-2xl p-8 backdrop-blur-xl relative z-10">

        <!-- App Brand Logo -->
        <div class="flex items-center justify-center gap-2.5 mb-6">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-500 via-indigo-600 to-violet-500 flex items-center justify-center text-white shadow-lg shadow-indigo-500/25">
                <i class="fa-solid fa-brain text-lg"></i>
            </div>
            <span class="text-xl font-extrabold text-white tracking-tight">AskMyNotes</span>
        </div>

        <p class="text-xs text-slate-400 text-center -mt-4 mb-6">Your Grounded AI Academic Study Studio</p>

        <!-- Toggle Tabs -->
        <div class="flex justify-center p-1 bg-[#0b0f19] border border-slate-800 rounded-xl mb-6">
            <button type="button" id="signInTab"
                class="flex-1 py-2 text-xs font-semibold rounded-lg bg-indigo-600 text-white transition-all shadow-sm">
                Sign In
            </button>
            <button type="button" id="signUpTab"
                class="flex-1 py-2 text-xs font-semibold rounded-lg text-slate-400 hover:text-white transition-all">
                Sign Up
            </button>
        </div>

        <!-- Form -->
        <form id="authForm" class="space-y-4">

            <!-- Username -->
            <div>
                <label class="block text-xs font-semibold text-slate-300 mb-1.5">Username / Email</label>
                <input type="text" name="username" required
                    class="w-full bg-[#0b0f19] border border-slate-800 rounded-xl px-4 py-2.5 text-sm text-slate-200 placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/50 focus:border-indigo-500 transition-all">
            </div>

            <!-- Password -->
            <div>
                <label class="block text-xs font-semibold text-slate-300 mb-1.5">Password</label>
                <input type="password" name="password" required
                    class="w-full bg-[#0b0f19] border border-slate-800 rounded-xl px-4 py-2.5 text-sm text-slate-200 placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/50 focus:border-indigo-500 transition-all">
            </div>

            <!-- Confirm Password (Hidden by default) -->
            <div id="confirmPasswordField" class="hidden">
                <label class="block text-xs font-semibold text-slate-300 mb-1.5">Confirm Password</label>
                <input type="password" name="confirmPassword"
                    class="w-full bg-[#0b0f19] border border-slate-800 rounded-xl px-4 py-2.5 text-sm text-slate-200 placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/50 focus:border-indigo-500 transition-all">
            </div>

            <!-- Submit Button -->
            <button type="submit"
                class="w-full bg-gradient-to-r from-indigo-500 to-violet-600 hover:from-indigo-600 hover:to-violet-700 text-white py-3 rounded-xl font-bold text-sm shadow-lg shadow-indigo-500/25 transition-all mt-2">
                Sign In
            </button>

        </form>

        <div class="mt-6 text-center text-[11px] text-slate-500">
            <a href="/" class="hover:text-indigo-400 transition-colors flex items-center justify-center gap-1">
                <i class="fa-solid fa-arrow-left text-[10px]"></i>
                <span>Return to Home</span>
            </a>
        </div>
    </div>

    <%- include('partials/toast') %>

    <script src="/js/auth.js"></script>

</body>
</html>