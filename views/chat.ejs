<%- include('partials/header', { title: (subject ? subject.name : 'Studio') + ' - AskMyNotes' }) %>

<body class="bg-[#080c14] text-slate-100 min-h-screen flex flex-col selection:bg-indigo-500 selection:text-white" data-subject-id="<%= subjectId %>">

    <%- include('partials/navbar') %>

    <!-- Studio Sub-Navbar (Modern Tech Palette) -->
    <div class="bg-[#0b0f19]/90 border-b border-slate-800/80 sticky top-16 z-30 backdrop-blur-md">
        <div class="max-w-7xl mx-auto px-4 sm:px-6">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between py-3 gap-3">
                
                <!-- Subject Header -->
                <div class="flex items-center gap-3">
                    <a href="/dashboard" class="w-8 h-8 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white flex items-center justify-center text-xs transition-colors border border-slate-700/60" title="Back to Dashboard">
                        <i class="fa-solid fa-arrow-left"></i>
                    </a>
                    <div>
                        <div class="flex items-center gap-2">
                            <h1 class="text-base sm:text-lg font-bold text-white tracking-tight flex items-center gap-1.5">
                                <%= subject ? subject.name : 'Subject Workspace' %>
                            </h1>
                            <span class="inline-flex items-center gap-1 text-[10px] font-mono uppercase font-bold tracking-wider px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                                Grounded AI
                            </span>
                        </div>
                        <p class="text-xs text-slate-400 font-medium">
                            <span id="doc-counter"><%= (subject && subject.notes) ? subject.notes.length : 0 %> document(s) uploaded</span>
                            &bull;
                            <button onclick="toggleDocSidebar()" class="text-indigo-400 hover:text-indigo-300 hover:underline font-semibold transition-colors">
                                View / Upload Notes
                            </button>
                        </p>
                    </div>
                </div>

                <!-- Learning Studio Navigation Tabs in Dark Tech Theme -->
                <div class="flex items-center gap-1 bg-slate-900/90 p-1 rounded-xl border border-slate-800 self-start sm:self-auto overflow-x-auto max-w-full">
                    <button onclick="switchTab('chat')" id="tab-btn-chat" class="studio-tab-btn active px-3.5 py-1.5 rounded-lg text-xs font-semibold transition-all flex items-center gap-1.5 bg-gradient-to-r from-indigo-500 to-violet-600 text-white shadow-md shadow-indigo-500/20">
                        <i class="fa-solid fa-comments text-xs"></i>
                        <span>Chat Q&A</span>
                    </button>

                    <button onclick="switchTab('summary')" id="tab-btn-summary" class="studio-tab-btn px-3.5 py-1.5 rounded-lg text-xs font-semibold text-slate-400 hover:text-white hover:bg-slate-800/60 transition-all flex items-center gap-1.5">
                        <i class="fa-solid fa-book-open text-xs"></i>
                        <span>Summarizer</span>
                    </button>

                    <button onclick="switchTab('flashcards')" id="tab-btn-flashcards" class="studio-tab-btn px-3.5 py-1.5 rounded-lg text-xs font-semibold text-slate-400 hover:text-white hover:bg-slate-800/60 transition-all flex items-center gap-1.5">
                        <i class="fa-solid fa-layer-group text-xs"></i>
                        <span>3D Flashcards</span>
                    </button>

                    <button onclick="switchTab('quiz')" id="tab-btn-quiz" class="studio-tab-btn px-3.5 py-1.5 rounded-lg text-xs font-semibold text-slate-400 hover:text-white hover:bg-slate-800/60 transition-all flex items-center gap-1.5">
                        <i class="fa-solid fa-bullseye text-xs"></i>
                        <span>Interactive Quiz</span>
                    </button>

                    <button onclick="switchTab('questions')" id="tab-btn-questions" class="studio-tab-btn px-3.5 py-1.5 rounded-lg text-xs font-semibold text-slate-400 hover:text-white hover:bg-slate-800/60 transition-all flex items-center gap-1.5">
                        <i class="fa-solid fa-list-check text-xs"></i>
                        <span>Short Answers</span>
                    </button>

                    <button onclick="switchTab('research')" id="tab-btn-research" class="studio-tab-btn px-3.5 py-1.5 rounded-lg text-xs font-semibold text-slate-400 hover:text-white hover:bg-slate-800/60 transition-all flex items-center gap-1.5">
                        <i class="fa-solid fa-microscope text-xs"></i>
                        <span>Research Studio</span>
                    </button>
                </div>

            </div>
        </div>
    </div>

    <!-- Main Workspace Container (Professional Sticky Layout) -->
    <div class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 py-6 flex gap-6 relative items-start">

        <!-- Left Document Notes Sidebar (Sticky: moves/sticks with page scroll) -->
        <aside id="doc-sidebar-pane" class="w-80 flex-shrink-0 bg-slate-900/90 border border-slate-800 rounded-2xl p-5 shadow-xl hidden lg:flex flex-col sticky top-32 h-[calc(100vh-9.5rem)] backdrop-blur-md z-20">
            <div class="flex items-center justify-between pb-3 border-b border-slate-800">
                <h3 class="text-sm font-bold text-white flex items-center gap-2">
                    <i class="fa-solid fa-folder-open text-indigo-400"></i>
                    <span>Subject Notes</span>
                </h3>
                <label class="cursor-pointer text-xs font-semibold px-2.5 py-1 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white transition-colors inline-flex items-center gap-1 shadow-sm shadow-indigo-500/25">
                    <i class="fa-solid fa-plus text-[10px]"></i>
                    <span>Upload</span>
                    <input type="file" id="sidebar-doc-upload" class="hidden" accept=".pdf,.txt,.docx,.doc,.pptx,.ppt,.png,.jpg,.jpeg,.webp" multiple>
                </label>
            </div>

            <!-- Upload drag/drop zone -->
            <div id="dropzone" class="my-3 border-2 border-dashed border-slate-700/80 hover:border-indigo-500 rounded-xl p-4 text-center cursor-pointer transition-colors bg-[#0b0f19]/60 group">
                <i class="fa-solid fa-cloud-arrow-up text-indigo-400 text-xl mb-1 group-hover:scale-110 transition-transform"></i>
                <p class="text-xs font-bold text-white">Upload PDF, DOCX, PPTX, Images</p>
                <p class="text-[10px] text-slate-400 mt-0.5">Documents & diagrams analyzed via Vision AI</p>
            </div>

            <!-- Document List -->
            <div class="flex-1 overflow-y-auto space-y-2 pr-1" id="sidebar-doc-list">
                <div class="text-center py-6 text-slate-500 text-xs italic">Loading documents...</div>
            </div>

            <div class="mt-auto pt-3 border-t border-slate-800 text-[11px] text-slate-400 bg-[#0b0f19]/60 p-2.5 rounded-xl flex items-center gap-2">
                <i class="fa-solid fa-shield-halved text-emerald-400 text-xs flex-shrink-0"></i>
                <span>Strict Provenance: Responses grounded exclusively in your files.</span>
            </div>
        </aside>

        <!-- Right / Center Studio Content -->
        <main class="flex-1 min-w-0 flex flex-col relative">

            <!-- TAB 1: Grounded RAG Chat (Modern Dark Tech Theme) -->
            <div id="tab-content-chat" class="studio-tab-content flex-1 flex flex-col relative">
                
                <!-- Chat Message Stream -->
                <div id="chat-box" class="flex-1 space-y-5 pb-16 min-h-[480px]">
                    <!-- Messages will be injected dynamically -->
                </div>

                <!-- Grounded Chat Dock (Sticky bottom-0: moves/sticks with page scroll) -->
                <div class="sticky bottom-0 z-30 pt-4 pb-2 bg-gradient-to-t from-[#080c14] via-[#080c14]/95 to-transparent backdrop-blur-md">
                    
                    <!-- Quick Prompt Chips -->
                    <div id="quick-prompt-bar" class="mb-2 flex items-center gap-1.5 overflow-x-auto py-1 scrollbar-none text-xs">
                        <button onclick="quickPrompt('Summarize the primary concepts across these notes in bullet points')" class="flex-shrink-0 bg-slate-900/90 hover:bg-slate-800 text-slate-200 hover:text-white border border-slate-800 hover:border-indigo-500/50 rounded-full px-3 py-1 shadow-sm transition-all flex items-center gap-1.5 font-medium">
                            <i class="fa-solid fa-sparkles text-indigo-400 text-[10px]"></i>
                            <span>Summary of Notes</span>
                        </button>
                        <button onclick="quickPrompt('Summarize the core workflow, process, and architecture from my notes into a clean visual Mermaid flowchart diagram')" class="flex-shrink-0 bg-slate-900/90 hover:bg-slate-800 text-indigo-300 hover:text-white border border-indigo-500/40 hover:border-indigo-500 rounded-full px-3 py-1 shadow-sm transition-all flex items-center gap-1.5 font-medium">
                            <i class="fa-solid fa-project-diagram text-indigo-400 text-[10px]"></i>
                            <span>Flowchart Diagram</span>
                        </button>
                        <button onclick="quickPrompt('What are the key terms, definitions, and formulas discussed?')" class="flex-shrink-0 bg-slate-900/90 hover:bg-slate-800 text-slate-200 hover:text-white border border-slate-800 hover:border-indigo-500/50 rounded-full px-3 py-1 shadow-sm transition-all flex items-center gap-1.5 font-medium">
                            <i class="fa-solid fa-book-bookmark text-indigo-400 text-[10px]"></i>
                            <span>Key Definitions</span>
                        </button>
                        <button onclick="quickPrompt('Explain the core mechanisms step-by-step with practical examples')" class="flex-shrink-0 bg-slate-900/90 hover:bg-slate-800 text-slate-200 hover:text-white border border-slate-800 hover:border-indigo-500/50 rounded-full px-3 py-1 shadow-sm transition-all flex items-center gap-1.5 font-medium">
                            <i class="fa-solid fa-gears text-indigo-400 text-[10px]"></i>
                            <span>Explain Mechanisms</span>
                        </button>
                        <button onclick="quickPrompt('Generate 3 exam-style conceptual practice questions with hints')" class="flex-shrink-0 bg-slate-900/90 hover:bg-slate-800 text-slate-200 hover:text-white border border-slate-800 hover:border-indigo-500/50 rounded-full px-3 py-1 shadow-sm transition-all flex items-center gap-1.5 font-medium">
                            <i class="fa-solid fa-circle-question text-indigo-400 text-[10px]"></i>
                            <span>Practice Drill</span>
                        </button>
                    </div>

                    <!-- Input Bar -->
                    <form id="chat-form" class="bg-[#0b101b] text-white rounded-2xl px-3 sm:px-4 py-2.5 shadow-2xl border border-slate-800 hover:border-slate-700 focus-within:border-indigo-500/70 focus-within:ring-2 focus-within:ring-indigo-500/20 flex items-end gap-2 transition-all">
                        
                        <button type="button" onclick="toggleDocSidebar()" class="w-8 h-8 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 flex items-center justify-center transition-colors flex-shrink-0" title="Toggle Notes Sidebar">
                            <i class="fa-solid fa-folder-open text-xs"></i>
                        </button>

                        <button type="button" id="voiceBtn" onclick="startVoiceRecording()" class="w-8 h-8 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 flex items-center justify-center transition-colors flex-shrink-0" title="Voice Input (Speech-to-Text)">
                            <i class="fa-solid fa-microphone text-xs"></i>
                        </button>

                        <button type="button" onclick="stopSpeaking()" class="w-8 h-8 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 flex items-center justify-center transition-colors flex-shrink-0" title="Stop Audio Playback">
                            <i class="fa-solid fa-volume-xmark text-xs"></i>
                        </button>

                        <textarea 
                            id="chat-input" 
                            rows="1" 
                            placeholder="Ask anything from your uploaded notes... (Shift+Enter for newline)"
                            class="flex-1 min-h-[38px] max-h-32 bg-transparent text-white placeholder-slate-500 focus:outline-none resize-none py-1.5 text-xs sm:text-sm leading-relaxed"
                            required
                        ></textarea>

                        <button type="submit" id="sendBtn" class="w-9 h-9 rounded-xl bg-gradient-to-r from-indigo-500 to-violet-600 hover:from-indigo-600 hover:to-violet-700 text-white flex items-center justify-center transition-all flex-shrink-0 shadow-md shadow-indigo-500/25" title="Send Question">
                            <i class="fa-solid fa-paper-plane text-xs"></i>
                        </button>
                    </form>

                    <!-- Footer Microbar -->
                    <div class="flex items-center justify-between text-[11px] py-1.5 px-2 text-slate-500">
                        <span class="flex items-center gap-1.5 text-slate-400">
                            <i class="fa-solid fa-shield-halved text-emerald-400 text-[10px]"></i>
                            <span>Strictly grounded in your documents with verified citations</span>
                        </span>
                        <button type="button" onclick="clearChat()" class="text-slate-500 hover:text-rose-400 transition-colors flex items-center gap-1">
                            <i class="fa-regular fa-trash-can text-[10px]"></i>
                            <span>Clear chat</span>
                        </button>
                    </div>
                </div>

            </div>

            <!-- TAB 2: Executive Summarizer (Modern Dark Tech Theme) -->
            <div id="tab-content-summary" class="studio-tab-content hidden flex-1 overflow-y-auto h-full pr-1 pb-12">
                <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-6 sm:p-8 shadow-xl backdrop-blur-md">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-5 border-b border-slate-800">
                        <div>
                            <h2 class="text-xl font-bold text-white tracking-tight flex items-center gap-2">
                                <i class="fa-solid fa-book-open text-indigo-400"></i>
                                <span>Executive Document Summarizer</span>
                            </h2>
                            <p class="text-xs text-slate-400 mt-1">Generate concise revision points or in-depth study breakdowns from your notes.</p>
                        </div>

                        <!-- Summary Type Buttons -->
                        <div class="flex items-center gap-1 bg-[#0b0f19] p-1 rounded-xl border border-slate-800">
                            <button onclick="requestSummary('short')" id="btn-sum-short" class="summary-type-btn active px-3 py-1.5 rounded-lg text-xs font-semibold bg-indigo-600 text-white shadow-sm">
                                Rapid (3-5 Bullets)
                            </button>
                            <button onclick="requestSummary('medium')" id="btn-sum-medium" class="summary-type-btn px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-400 hover:text-white">
                                Conceptual
                            </button>
                            <button onclick="requestSummary('detailed')" id="btn-sum-detailed" class="summary-type-btn px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-400 hover:text-white">
                                Master Guide
                            </button>
                        </div>
                    </div>

                    <!-- Summary Output Area -->
                    <div id="summary-result-box" class="mt-6">
                        <div class="text-center py-16 text-slate-400">
                            <div class="w-14 h-14 rounded-2xl bg-indigo-500/10 text-indigo-400 flex items-center justify-center text-2xl mx-auto mb-3 border border-indigo-500/20">
                                <i class="fa-solid fa-book-open"></i>
                            </div>
                            <h4 class="text-base font-bold text-white">Generate Your First Summary</h4>
                            <p class="text-xs text-slate-400 max-w-sm mx-auto mt-1 mb-5">Click any option above to distill your uploaded documents into actionable revision notes.</p>
                            <button onclick="requestSummary('medium')" class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-indigo-500 to-violet-600 hover:from-indigo-600 hover:to-violet-700 text-white font-semibold text-xs shadow-md shadow-indigo-500/20 transition-all">
                                Generate Conceptual Summary
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TAB 3: Interactive 3D Flashcards (Modern Dark Tech Theme) -->
            <div id="tab-content-flashcards" class="studio-tab-content hidden flex-1 overflow-y-auto h-full pr-1 pb-12">
                <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-6 sm:p-8 shadow-xl backdrop-blur-md">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-800">
                        <div>
                            <h2 class="text-xl font-bold text-white tracking-tight flex items-center gap-2">
                                <i class="fa-solid fa-layer-group text-indigo-400"></i>
                                <span>Interactive 3D Study Flashcards</span>
                            </h2>
                            <p class="text-xs text-slate-400 mt-1">Test your recall. Click the card or press Spacebar to flip between question and grounded explanation.</p>
                        </div>

                        <button onclick="generateFlashcardsDeck()" id="btn-gen-flashcards" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-gradient-to-r from-indigo-500 to-violet-600 hover:from-indigo-600 hover:to-violet-700 text-white font-semibold text-xs shadow-md shadow-indigo-500/20 transition-all">
                            <i class="fa-solid fa-arrows-rotate text-xs"></i>
                            <span>Generate Card Deck</span>
                        </button>
                    </div>

                    <!-- Flashcard 3D Stage -->
                    <div id="flashcard-stage" class="mt-8 flex flex-col items-center">
                        <div class="text-center py-16 text-slate-400">
                            <div class="w-14 h-14 rounded-2xl bg-indigo-500/10 text-indigo-400 flex items-center justify-center text-2xl mx-auto mb-3 border border-indigo-500/20">
                                <i class="fa-solid fa-layer-group"></i>
                            </div>
                            <h4 class="text-base font-bold text-white">No Flashcard Deck Active</h4>
                            <p class="text-xs text-slate-400 max-w-sm mx-auto mt-1 mb-5">Click below to generate revision cards based on your uploaded subject notes.</p>
                            <button onclick="generateFlashcardsDeck()" class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-indigo-500 to-violet-600 hover:from-indigo-600 hover:to-violet-700 text-white font-semibold text-xs shadow-md shadow-indigo-500/20 transition-all">
                                Generate 8 Study Cards
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TAB 4: Interactive Quiz Arena (Modern Dark Tech Theme) -->
            <div id="tab-content-quiz" class="studio-tab-content hidden flex-1 overflow-y-auto h-full pr-1 pb-12">
                <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-6 sm:p-8 shadow-xl backdrop-blur-md">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-800">
                        <div>
                            <h2 class="text-xl font-bold text-white tracking-tight flex items-center gap-2">
                                <i class="fa-solid fa-bullseye text-indigo-400"></i>
                                <span>Interactive Practice Assessment</span>
                            </h2>
                            <p class="text-xs text-slate-400 mt-1">Select an option to receive immediate feedback, explanations, and live scoring.</p>
                        </div>

                        <button onclick="startInteractiveQuiz()" id="btn-start-quiz" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-gradient-to-r from-indigo-500 to-violet-600 hover:from-indigo-600 hover:to-violet-700 text-white font-semibold text-xs shadow-md shadow-indigo-500/20 transition-all">
                            <i class="fa-solid fa-play text-xs"></i>
                            <span>Generate New Quiz (5 MCQs)</span>
                        </button>
                    </div>

                    <!-- Quiz Arena Container -->
                    <div id="quiz-arena" class="mt-8">
                        <div class="text-center py-16 text-slate-400">
                            <div class="w-14 h-14 rounded-2xl bg-indigo-500/10 text-indigo-400 flex items-center justify-center text-2xl mx-auto mb-3 border border-indigo-500/20">
                                <i class="fa-solid fa-bullseye"></i>
                            </div>
                            <h4 class="text-base font-bold text-white">Ready for Practice?</h4>
                            <p class="text-xs text-slate-400 max-w-sm mx-auto mt-1 mb-5">Generate 5 multiple-choice questions validated against your uploaded notes.</p>
                            <button onclick="startInteractiveQuiz()" class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-indigo-500 to-violet-600 hover:from-indigo-600 hover:to-violet-700 text-white font-semibold text-xs shadow-md shadow-indigo-500/20 transition-all">
                                Start 5-Question Quiz
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TAB 5: Conceptual Short Answer Questions (Modern Dark Tech Theme) -->
            <div id="tab-content-questions" class="studio-tab-content hidden flex-1 overflow-y-auto h-full pr-1 pb-12">
                <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-6 sm:p-8 shadow-xl backdrop-blur-md">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-800">
                        <div>
                            <h2 class="text-xl font-bold text-white tracking-tight flex items-center gap-2">
                                <i class="fa-solid fa-feather-pointed text-indigo-400"></i>
                                <span>Conceptual Short-Answer Drills</span>
                            </h2>
                            <p class="text-xs text-slate-400 mt-1">Review complex concepts with 3-5 sentence model answers and verified source citations.</p>
                        </div>

                        <button onclick="generateShortAnswerDrill()" id="btn-gen-short" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-gradient-to-r from-indigo-500 to-violet-600 hover:from-indigo-600 hover:to-violet-700 text-white font-semibold text-xs shadow-md shadow-indigo-500/20 transition-all">
                            <i class="fa-solid fa-arrows-rotate text-xs"></i>
                            <span>Generate Short Answers</span>
                        </button>
                    </div>

                    <!-- Short Answers Container -->
                    <div id="short-answer-container" class="mt-6 space-y-4">
                        <div class="text-center py-16 text-slate-400">
                            <div class="w-14 h-14 rounded-2xl bg-indigo-500/10 text-indigo-400 flex items-center justify-center text-2xl mx-auto mb-3 border border-indigo-500/20">
                                <i class="fa-solid fa-feather-pointed"></i>
                            </div>
                            <h4 class="text-base font-bold text-white">No Short Answer Drill Active</h4>
                            <p class="text-xs text-slate-400 max-w-sm mx-auto mt-1 mb-5">Click below to generate 3 short-answer questions with detailed model answers.</p>
                            <button onclick="generateShortAnswerDrill()" class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-indigo-500 to-violet-600 hover:from-indigo-600 hover:to-violet-700 text-white font-semibold text-xs shadow-md shadow-indigo-500/20 transition-all">
                                Generate Drill
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TAB 6: Research Paper Intelligence Studio (Modern Dark Tech Theme) -->
            <div id="tab-content-research" class="studio-tab-content hidden flex-1 overflow-y-auto h-full pr-1 pb-12">
                <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-6 sm:p-8 shadow-xl backdrop-blur-md">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-800">
                        <div>
                            <div class="flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-indigo-400 animate-pulse"></span>
                                <h2 class="text-xl font-bold text-white tracking-tight flex items-center gap-2">
                                    <i class="fa-solid fa-microscope text-indigo-400"></i>
                                    <span>Research Paper Intelligence Studio</span>
                                </h2>
                            </div>
                            <p class="text-xs text-slate-400 mt-1">Extract core hypotheses, algorithmic methodologies, architectural diagrams, peer critiques, and formatted BibTeX citations.</p>
                        </div>

                        <!-- Research Mode Switcher -->
                        <div class="flex items-center gap-1 bg-[#0b0f19] p-1 rounded-xl border border-slate-800 self-start sm:self-auto overflow-x-auto max-w-full">
                            <button onclick="requestResearch('breakdown')" id="btn-res-breakdown" class="research-mode-btn active px-3 py-1.5 rounded-lg text-xs font-semibold bg-indigo-600 text-white shadow-sm flex items-center gap-1.5">
                                <i class="fa-solid fa-file-invoice text-[11px]"></i>
                                <span>Paper Breakdown</span>
                            </button>
                            <button onclick="requestResearch('methodology')" id="btn-res-methodology" class="research-mode-btn px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-400 hover:text-white transition-colors flex items-center gap-1.5">
                                <i class="fa-solid fa-gears text-[11px]"></i>
                                <span>Methodology Deep-Dive</span>
                            </button>
                            <button onclick="requestResearch('critique')" id="btn-res-critique" class="research-mode-btn px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-400 hover:text-white transition-colors flex items-center gap-1.5">
                                <i class="fa-solid fa-scale-balanced text-[11px]"></i>
                                <span>Peer Review Critique</span>
                            </button>
                            <button onclick="requestResearch('citations')" id="btn-res-citations" class="research-mode-btn px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-400 hover:text-white transition-colors flex items-center gap-1.5">
                                <i class="fa-solid fa-quote-left text-[11px]"></i>
                                <span>BibTeX & Citations</span>
                            </button>
                        </div>
                    </div>

                    <!-- Dedicated Research Paper Upload Section -->
                    <div class="mt-5 p-4 rounded-xl bg-[#0b0f19] border border-slate-800 flex flex-col md:flex-row md:items-center justify-between gap-4">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-xl bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 flex items-center justify-center text-lg flex-shrink-0">
                                <i class="fa-solid fa-file-shield"></i>
                            </div>
                            <div>
                                <div class="flex items-center gap-2">
                                    <span class="text-xs font-bold text-white">Active Research Paper:</span>
                                    <span id="research-paper-name" class="font-mono text-xs text-indigo-300 bg-indigo-950/60 px-2 py-0.5 rounded border border-indigo-800/60 truncate max-w-[260px] sm:max-w-md">No separate paper uploaded</span>
                                </div>
                                <p class="text-[11px] text-slate-400 mt-0.5">Upload a dedicated research paper (PDF/DOCX) specifically for this tab. It operates separately from your general subject notes.</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-2 self-start md:self-auto">
                            <input type="file" id="research-paper-file-input" accept=".pdf,.docx,.txt" class="hidden" onchange="handleResearchPaperUpload(this.files[0])">
                            <button onclick="document.getElementById('research-paper-file-input').click()" id="btn-upload-research-paper" class="px-3.5 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-xs transition-colors flex items-center gap-2 shadow-md shadow-indigo-500/20 flex-shrink-0">
                                <i class="fa-solid fa-cloud-arrow-up text-xs"></i>
                                <span id="btn-upload-research-text">Upload Dedicated Paper</span>
                            </button>
                        </div>
                    </div>

                    <!-- Research Result Area -->
                    <div id="research-result-box" class="mt-6">
                        <div class="text-center py-16 text-slate-400">
                            <div class="w-14 h-14 rounded-2xl bg-indigo-500/10 text-indigo-400 flex items-center justify-center text-2xl mx-auto mb-3 border border-indigo-500/20">
                                <i class="fa-solid fa-microscope"></i>
                            </div>
                            <h4 class="text-base font-bold text-white">Analyze Your Uploaded Research Paper</h4>
                            <p class="text-xs text-slate-400 max-w-md mx-auto mt-1 mb-5 leading-relaxed">
                                Select an analysis mode above to distill complex research into methodologies, diagram breakdowns, peer critique, or BibTeX references.
                            </p>
                            <button onclick="requestResearch('breakdown')" class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-indigo-500 to-violet-600 hover:from-indigo-600 hover:to-violet-700 text-white font-semibold text-xs shadow-md shadow-indigo-500/20 transition-all">
                                Run Comprehensive Paper Breakdown
                            </button>
                        </div>
                    </div>
                </div>
            </div>

        </main>
    </div>

    <!-- Visual Document Citation & Bounding Box Inspector Modal -->
    <div id="citationInspectorModal" class="hidden fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4 animate-in fade-in duration-200">
        <div class="max-w-3xl w-full bg-[#0b0f19] border border-slate-800 rounded-2xl shadow-2xl overflow-hidden flex flex-col max-h-[90vh]">
            
            <!-- Modal Header -->
            <div class="px-6 py-4 bg-slate-900/90 border-b border-slate-800 flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-xl bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 flex items-center justify-center text-sm">
                        <i class="fa-solid fa-crosshairs"></i>
                    </div>
                    <div>
                        <div class="flex items-center gap-2">
                            <h3 class="text-sm font-bold text-white font-mono" id="inspector-doc-title">Document Citation</h3>
                            <span class="text-[10px] bg-indigo-500/20 text-indigo-300 font-mono px-2 py-0.5 rounded-full border border-indigo-500/30 font-semibold" id="inspector-chunk-badge">#1</span>
                        </div>
                        <p class="text-xs text-slate-400">Strict Provenance Coordinate Inspector & Grounding Evidence</p>
                    </div>
                </div>

                <div class="flex items-center gap-2">
                    <span class="hidden sm:inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-mono font-semibold" id="inspector-match-badge">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                        98.6% Cosine Grounding
                    </span>
                    <button onclick="closeCitationInspector()" class="w-8 h-8 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-400 hover:text-white flex items-center justify-center transition-colors">
                        <i class="fa-solid fa-xmark text-sm"></i>
                    </button>
                </div>
            </div>

            <!-- Modal Content Body -->
            <div class="p-6 overflow-y-auto space-y-5">
                
                <!-- Coordinate Metrics Strip -->
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                    <div class="bg-slate-900/80 border border-slate-800/80 rounded-xl p-3 text-center">
                        <div class="text-[10px] uppercase font-mono text-slate-500 font-bold">Document Page</div>
                        <div class="text-sm font-bold text-white font-mono mt-0.5" id="inspector-page-num">Page 1</div>
                    </div>
                    <div class="bg-slate-900/80 border border-slate-800/80 rounded-xl p-3 text-center">
                        <div class="text-[10px] uppercase font-mono text-slate-500 font-bold">Bounding Box Coordinates</div>
                        <div class="text-xs font-bold text-indigo-400 font-mono mt-0.5" id="inspector-coords">[140, 48, 270, 552]</div>
                    </div>
                    <div class="bg-slate-900/80 border border-slate-800/80 rounded-xl p-3 text-center">
                        <div class="text-[10px] uppercase font-mono text-slate-500 font-bold">Retrieval Rank</div>
                        <div class="text-sm font-bold text-emerald-400 font-mono mt-0.5" id="inspector-rank">#1 Cosine Match</div>
                    </div>
                    <div class="bg-slate-900/80 border border-slate-800/80 rounded-xl p-3 text-center">
                        <div class="text-[10px] uppercase font-mono text-slate-500 font-bold">Verification State</div>
                        <div class="text-xs font-bold text-purple-400 font-mono mt-0.5">Strict RAG Grounded</div>
                    </div>
                </div>

                <!-- Visual Page & Bounding Box Viewport -->
                <div>
                    <div class="flex items-center justify-between text-xs text-slate-400 mb-2">
                        <span class="font-bold uppercase tracking-wider text-[11px] font-mono text-indigo-400 flex items-center gap-1.5">
                            <i class="fa-regular fa-file-pdf"></i>
                            <span>Visual Document Coordinate Viewport</span>
                        </span>
                        <span class="font-mono text-[11px] text-slate-500">Target bounding box highlighted</span>
                    </div>

                    <div class="bg-[#080c14] border border-slate-800 rounded-xl p-5 relative overflow-hidden shadow-inner">
                        <div class="max-w-xl mx-auto bg-slate-900/90 border border-slate-700/80 rounded-lg p-5 shadow-2xl relative">
                            <!-- Page header mockup -->
                            <div class="flex items-center justify-between pb-3 mb-3 border-b border-slate-800 text-[10px] font-mono text-slate-500">
                                <span id="inspector-preview-filename">document.pdf</span>
                                <span id="inspector-preview-page">Page 1 of Document</span>
                            </div>

                            <!-- Mock paragraph lines above -->
                            <div class="space-y-1.5 opacity-30 mb-3">
                                <div class="h-2 bg-slate-600 rounded w-full"></div>
                                <div class="h-2 bg-slate-600 rounded w-5/6"></div>
                                <div class="h-2 bg-slate-600 rounded w-4/6"></div>
                            </div>

                            <!-- Highlighted Bounding Box Area -->
                            <div class="relative p-3.5 rounded-lg border-2 border-indigo-500/80 bg-indigo-500/10 shadow-lg shadow-indigo-500/10 transition-all">
                                <div class="absolute -top-2.5 right-3 px-2 py-0.5 rounded bg-indigo-600 text-white font-mono text-[9px] font-bold tracking-wider">
                                    TARGET CITATION BOUNDING BOX
                                </div>
                                <p class="text-xs sm:text-sm text-indigo-100 font-mono leading-relaxed" id="inspector-highlighted-text">
                                    Loading grounded text excerpt...
                                </p>
                            </div>

                            <!-- Mock paragraph lines below -->
                            <div class="space-y-1.5 opacity-30 mt-3">
                                <div class="h-2 bg-slate-600 rounded w-11/12"></div>
                                <div class="h-2 bg-slate-600 rounded w-4/5"></div>
                                <div class="h-2 bg-slate-600 rounded w-3/4"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Verified Source Excerpt -->
                <div class="bg-slate-900/80 border border-slate-800 rounded-xl p-4">
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 font-mono">
                            Verified Source Excerpt
                        </span>
                        <button onclick="copyInspectorExcerpt()" class="text-xs text-indigo-400 hover:text-indigo-300 font-semibold flex items-center gap-1 transition-colors">
                            <i class="fa-regular fa-copy text-[11px]"></i>
                            <span>Copy Excerpt</span>
                        </button>
                    </div>
                    <blockquote class="italic text-xs text-slate-300 leading-relaxed border-l-2 border-indigo-500 pl-3 py-1 font-sans" id="inspector-quote-text">
                        Loading excerpt...
                    </blockquote>
                </div>

            </div>

            <!-- Modal Footer -->
            <div class="px-6 py-3.5 bg-slate-900/90 border-t border-slate-800 flex items-center justify-between">
                <span class="text-xs text-slate-500 font-mono">
                    <i class="fa-solid fa-shield-check text-emerald-400 mr-1"></i>
                    Citation cross-verified by AskMyNotes RAG Engine
                </span>
                <div class="flex items-center gap-2">
                    <button onclick="copyCitationReference()" class="px-3.5 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-semibold transition-colors flex items-center gap-1.5">
                        <i class="fa-regular fa-clipboard"></i>
                        <span>Copy Citation Tag</span>
                    </button>
                    <button onclick="closeCitationInspector()" class="px-4 py-1.5 rounded-lg bg-gradient-to-r from-indigo-500 to-violet-600 hover:from-indigo-600 hover:to-violet-700 text-white text-xs font-semibold transition-all shadow-md shadow-indigo-500/20">
                        Close
                    </button>
                </div>
            </div>

        </div>
    </div>

    <%- include('partials/toast') %>
    <script src="/js/chat.js"></script>
</body>
</html>