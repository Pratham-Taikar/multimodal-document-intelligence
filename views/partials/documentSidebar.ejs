<!-- Document Modal Overlay (Modern Dark Tech Theme) -->
<div id="doc-overlay"
     class="fixed inset-0 bg-black/60 backdrop-blur-sm hidden z-50 flex items-center justify-center p-4"
     onclick="closeDocSidebar()">

    <!-- Modal Box -->
    <div id="doc-sidebar"
         class="bg-slate-900 w-full sm:w-[460px] max-h-[85vh]
                rounded-2xl shadow-2xl border border-slate-800
                transform scale-95 opacity-0
                transition-all duration-300
                flex flex-col overflow-hidden"
         onclick="event.stopPropagation()">

        <!-- Header -->
        <div class="p-4 sm:p-5 border-b border-slate-800 flex justify-between items-center bg-[#0b0f19]">
            <h2 class="text-base font-bold text-white flex items-center gap-2">
                <i class="fa-solid fa-folder-open text-indigo-400"></i>
                <span>Uploaded Documents</span>
            </h2>
            <button onclick="closeDocSidebar()"
                    class="w-7 h-7 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 flex items-center justify-center transition-colors">
                <i class="fa-solid fa-xmark text-sm"></i>
            </button>
        </div>

        <!-- File List -->
        <div id="doc-list"
             class="flex-1 overflow-y-auto p-4 sm:p-5 space-y-2.5 text-xs text-slate-300">
            <!-- Documents injected dynamically -->
        </div>

    </div>
</div>