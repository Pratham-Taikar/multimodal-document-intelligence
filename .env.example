# ============================================
# AskMyNotes - Environment Configuration
# ============================================

# Server
PORT=3000

# MongoDB
# Replace with your MongoDB Atlas connection string
MONGODB_URI=

# Session security
# Replace this with a long random secret
SESSION_SECRET=change_this_to_a_long_random_secret

# Google Gemini API
# Replace with your Gemini API key
# OpenRouter API
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free,qwen/qwen3.8-27b:free
AI_PROVIDER_ORDER=openrouter
AI_MAX_RETRIES=2
AI_RETRY_BASE_DELAY_MS=250