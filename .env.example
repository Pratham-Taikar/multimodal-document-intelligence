# ============================================
# AskMyNotes - Environment Configuration
# ============================================

# Server
PORT=3000
APP_URL=http://localhost:3000

# MongoDB
# Replace with your MongoDB Atlas or local connection string
# Local: mongodb://localhost:27017/askmynotes
# Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/askmynotes
MONGODB_URI=mongodb://localhost:27017/askmynotes

# Session security
SESSION_SECRET=change_this_to_a_long_random_secret

# AI Provider Priority Order (comma separated: ollama,minimax,openrouter)
# Default order prioritizes offline Ollama first, then MiniMax, then OpenRouter
AI_PROVIDER_ORDER=ollama,minimax,openrouter
AI_MAX_RETRIES=2
AI_RETRY_BASE_DELAY_MS=250

# --- 1. Offline Local AI (Ollama) ---
# Download Ollama from https://ollama.com and run: ollama run llama3.2 (or qwen2.5:3b)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# --- 2. MiniMax AI ---
# Obtain API key from https://platform.minimaxi.com or https://api.minimax.chat
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_MODEL=MiniMax-Text-01

# --- 3. OpenRouter AI (Cloud Fallback) ---
# Obtain API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free,qwen/qwen3.8-27b:free