# ============================================
# AskMyNotes - Environment Configuration
# ============================================

# Server
PORT=3000
APP_URL=http://localhost:3000

# MongoDB
# Replace with your MongoDB Atlas or local connection string
# Local: mongodb://localhost:27017/askmynotes
# Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/askmynotes
MONGODB_URI=mongodb://localhost:27017/askmynotes

# Session security
SESSION_SECRET=change_this_to_a_long_random_secret

# AI Provider Priority Order (comma separated: gemini,groq,openrouter,minimax,ollama)
# Priority: Primary Gemini (with multi-key rotation) -> Fast Groq Cloud (~500 t/s) -> Local Ollama (Low-End PC)
AI_PROVIDER_ORDER=gemini,groq,openrouter,ollama
AI_MAX_RETRIES=2
AI_RETRY_BASE_DELAY_MS=250

# --- 1. Google Gemini (Supports Multi-Key Auto-Rotation) ---
# Comma-separated keys will automatically rotate when rate limits (429) are reached
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- 2. Groq Cloud AI (100% Free, Blazing Fast ~500 tokens/sec) ---
# Obtain free key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# --- 3. Offline Local AI (Ollama - Tuned for Low-End PCs) ---
# Download Ollama from https://ollama.com
# For low-end PC without GPU: run `ollama run llama3.2:1b` (1 billion parameters, uses ~1.3GB RAM)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2:1b
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PREDICT=512

# --- 4. OpenRouter AI (Cloud Fallback) ---
# Obtain API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
OPENROUTER_FALLBACK_MODELS=meta-llama/llama-3.3-70b-instruct:free,qwen/qwen-2.5-72b-instruct:free

# --- 5. MiniMax AI (Optional) ---
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_MODEL=MiniMax-Text-01