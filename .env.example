# ==============================================================================
# Multimodal Document Intelligence - Environment Configuration Template
# Copy this file to .env and adjust variables as appropriate for your environment.
# `.env` is gitignored — never commit real secrets.
# ==============================================================================

# Application Environment (development, testing, production)
APP_ENV=development
APP_NAME="Multimodal Document Intelligence API"
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Security & CORS (comma-separated origins)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Database Configuration (PostgreSQL 16 + pgvector)
POSTGRES_USER=mdi_user
POSTGRES_PASSWORD=mdi_password_local_dev
POSTGRES_DB=mdi_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Async Database URL used by FastAPI and SQLAlchemy.
# Host development (Compose exposes PostgreSQL on 5433):
DATABASE_URL=postgresql+asyncpg://mdi_user:mdi_password_local_dev@localhost:5433/mdi_db
# Docker Compose overrides this automatically to reach `postgres:5432` internally.

# Frontend Environment Variables
# Leave empty: the browser calls same-origin relative URLs (/api/...) and the
# Vite dev server proxies them to the backend.
VITE_API_BASE_URL=
# Vite dev-server proxy target (server-side only; where /api/* is forwarded).
VITE_API_PROXY_TARGET=http://localhost:8000
