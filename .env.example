# ==============================================================================
# Multimodal Document Intelligence - Environment Configuration Template
# Copy this file to .env and adjust variables as appropriate for your environment.
# ==============================================================================

# Application Environment (development, testing, production)
APP_ENV=development
APP_NAME="Multimodal Document Intelligence API"
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Security & CORS (comma-separated origins)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Database Configuration (PostgreSQL 16 + pgvector)
POSTGRES_USER=mdi_user
POSTGRES_PASSWORD=mdi_password_local_dev
POSTGRES_DB=mdi_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Async Database URL used by FastAPI and SQLAlchemy
# For local development against exposed host port: postgresql+asyncpg://mdi_user:mdi_password_local_dev@localhost:5433/mdi_db
# For Docker internal network: postgresql+asyncpg://mdi_user:mdi_password_local_dev@postgres:5432/mdi_db
DATABASE_URL=postgresql+asyncpg://mdi_user:mdi_password_local_dev@localhost:5433/mdi_db

# Frontend Environment Variables
VITE_API_BASE_URL=http://localhost:8000
